      "text": "src/\n│\n├── router/\n├── providers/\n├── layouts/\n└── store/\n│\n├── pages/                     # Route pages\n│   ├── marketing/\n│   │   ├── Home/\n│   │   ├── Features/\n│   │   ├── Pricing/\n│   │   ├── About/\n│   │   ├── Contact/\n│   │   └── legal/\n│   │       ├── Privacy/\n│   │       └── Terms/\n│   │\n│   ├── auth/\n│   │   ├── Login/\n│   │   ├── Register/\n│   │   └── Onboarding/\n│   │\n│   ├── dashboard/\n│   │   ├── Workspace/\n│   │   ├── RecentBoards/\n│   │   └── TeamBoards/\n│   │\n│   ├── whiteboard/\n│   │   └── BoardPage/\n│   │\n│   └── settings/\n│       ├── Profile/\n│       └── Billing/\n│\n├── features/                  # Feature-based architecture\n│   │\n│   ├── whiteboard/\n│   │   ├── components/\n│   │   │   ├── AIPanel/\n│   │   │   ├── Canvas/\n│   │   │   ├── Toolbar/\n│   │   │   ├── Sidebar/\n│   │   │   ├── LayersPanel/\n│   │   │   ├── ZoomControls/\n│   │   │   ├── PropertiesPanel/\n│   │   │   ├── TopNav/\n│   │   │   └── Minimap/\n│   │   │\n│   │   ├── tools/\n│   │   │   ├── PenTool/\n│   │   │   ├── ShapeTool/\n│   │   │   ├── StickyNotes/\n│   │   │   └── TextTool/\n│   │   │\n│   │   ├── ai/\n│   │   │   ├── MessCleanup/\n│   │   │   ├     ├── MessCleanupToggle.jsx\n│   │   │   ├     ├── useMessCleanup.js\n│   │   │   ├     └── cleanupEngine.js\n│   │   │   ├── ArchitectureAssist/\n│   │   │   └── ContextLayer/\n│   │   │\n│   │   ├── realtime/\n│   │   │   ├── socket/\n│   │   │   ├── presence/\n│   │   │   └── collaboration/\n│   │   │\n│   │   ├── hooks/\n│   │   ├── services/\n│   │   ├── store/\n│   │   ├── utils/\n│   │   ├── types/\n│   │   └── constants/\n│   │\n│   ├── auth/\n│   ├── billing/\n│   ├── teams/\n│   └── notifications/\n│\n├── components/                # Shared reusable UI\n│   ├── ui/\n│   ├── forms/\n│   ├── modals/\n│   ├── loaders/\n│   ├── navbar/\n│   └── footer/\n│\n├── services/                  # Global APIs\n│   ├── api/\n│   ├── socket/\n│   ├── stripe/\n│   └── razorpay/\n│\n├── hooks/\n├── lib/\n├── utils/\n├── App.css\n├── App.jsx\n├── assets/\n└── main.jsx",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "src/\n│\n├── router/\n├── providers/\n├── layouts/\n└── store/\n│\n├── pages/                     # Route pages\n│   ├── marketing/\n│   │   ├── Home/\n│   │   ├── Features/\n│   │   ├── Pricing/\n│   │   ├── About/\n│   │   ├── Contact/\n│   │   └── legal/\n│   │       ├── Privacy/\n│   │       └── Terms/\n│   │\n│   ├── auth/\n│   │   ├── Login/\n│   │   ├── Register/\n│   │   └── Onboarding/\n│   │\n│   ├── dashboard/\n│   │   ├── Workspace/\n│   │   ├── RecentBoards/\n│   │   └── TeamBoards/\n│   │\n│   ├── whiteboard/\n│   │   └── BoardPage/\n│   │\n│   └── settings/\n│       ├── Profile/\n│       └── Billing/\n│\n├── features/                  # Feature-based architecture\n│   │\n│   ├── whiteboard/\n│   │   ├── components/\n│   │   │   ├── AIPanel/\n│   │   │   ├── Canvas/\n│   │   │   ├── Toolbar/\n│   │   │   ├── Sidebar/\n│   │   │   ├── LayersPanel/\n│   │   │   ├── ZoomControls/\n│   │   │   ├── PropertiesPanel/\n│   │   │   ├── TopNav/\n│   │   │   └── Minimap/\n│   │   │\n│   │   ├── tools/\n│   │   │   ├── PenTool/\n│   │   │   ├── ShapeTool/\n│   │   │   ├── StickyNotes/\n│   │   │   └── TextTool/\n│   │   │\n│   │   ├── ai/\n│   │   │   ├── MessCleanup/\n│   │   │   ├     ├── MessCleanupToggle.jsx\n│   │   │   ├     ├── useMessCleanup.js\n│   │   │   ├     └── cleanupEngine.js\n│   │   │   ├── ArchitectureAssist/\n│   │   │   └── ContextLayer/\n│   │   │\n│   │   ├── realtime/\n│   │   │   ├── socket/\n│   │   │   ├── presence/\n│   │   │   └── collaboration/\n│   │   │\n│   │   ├── hooks/\n│   │   ├── services/\n│   │   ├── store/\n│   │   ├── utils/\n│   │   ├── types/\n│   │   └── constants/\n│   │\n│   ├── auth/\n│   ├── billing/\n│   ├── teams/\n│   └── notifications/\n│\n├── components/                # Shared reusable UI\n│   ├── ui/\n│   ├── forms/\n│   ├── modals/\n│   ├── loaders/\n│   ├── navbar/\n│   └── footer/\n│\n├── services/                  # Global APIs\n│   ├── api/\n│   ├── socket/\n│   ├── stripe/\n│   └── razorpay/\n│\n├── hooks/\n├── lib/\n├── utils/\n├── App.css\n├── App.jsx\n├── assets/\n└── main.jsx",
